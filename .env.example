# Copy to .env.local and fill in with YOUR OWN Supabase project + keys.
# (.env.local is gitignored on purpose — real keys are never committed.)

# --- Supabase (use your own project's values) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI engine (calls/messages -> summaries, tasks, deals). Use your own OpenAI key. ---
OPENAI_API_KEY=

# --- Local login bypass. MUST stay unset (or 0) in any shared/prod env. Set to 1 ONLY on a local dev box. ---
NEXT_PUBLIC_DISABLE_AUTH=

# --- Optional / other app areas (payments etc.) — set if you use them ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BAZAAR_PRICING_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NOTE: the new CRM pages read the `azat` Postgres schema. Your DB must have that schema
# (with your data) and PostgREST must expose it — see DEPLOY-HANDOFF-2026-08-07.md.
