# Supabase — copy from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Service-role key — server-only, NEVER expose to the browser
SUPABASE_SECRET_KEY=your-service-role-key

# Canonical site URL — used for Supabase redirect URLs and email links
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app   # REQUIRED: set this to your real domain in Vercel env vars

# Twilio — SMS and WhatsApp messaging
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx

# Instantly AI — email outreach
INSTANTLY_API_KEY=your-instantly-api-key
INSTANTLY_SENDING_ACCOUNT=you@yourdomain.com

# Stripe — payments
# For local dev: use test keys (pk_test_... / sk_test_...) from dashboard.stripe.com → Developers → API keys (Test mode ON)
# For production (Vercel): use live keys (pk_live_... / sk_live_...) from the same page with Test mode OFF
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # safe to expose in the browser
STRIPE_SECRET_KEY=sk_test_...                    # server-only, NEVER expose to the browser
# For local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook` — it prints this value
# For production (Vercel): get from dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...                  # used to verify webhook payloads

