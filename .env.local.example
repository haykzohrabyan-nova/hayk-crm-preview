# Supabase — copy from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Service-role key — server-only, NEVER expose to the browser
SUPABASE_SECRET_KEY=your-service-role-key

# Canonical site URL — used for Supabase redirect URLs and email links
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app   # REQUIRED: set this to your real domain in Vercel env vars

# Twilio — SMS and WhatsApp messaging
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx

# Instantly AI — email outreach
INSTANTLY_API_KEY=your-instantly-api-key
INSTANTLY_SENDING_ACCOUNT=you@yourdomain.com

# Vercel Cron — quote follow-up reminders (TODO-006)
# Required for GET /api/cron/follow-ups (manual curl or Vercel Cron on Pro).
# Safe to set on Hobby — does not affect the rest of the app; auto-schedule needs Pro.
# Generate: openssl rand -base64 32
CRON_SECRET=your-long-random-secret

# Sentry — error monitoring (sentry.io)
# NEXT_PUBLIC_SENTRY_DSN and SENTRY_DSN: copy from sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123.ingest.us.sentry.io/456
SENTRY_DSN=https://your-key@o123.ingest.us.sentry.io/456
# SENTRY_AUTH_TOKEN: create at sentry.io → Settings → Auth Tokens (project:releases + org:read)
# Store in .env.sentry-build-plugin (gitignored), not here.

# Order webhook — fired whenever a ticket becomes an order (quote→order conversion OR direct order creation).
# Payload matches the workflow-rho-one external API contract (customer_name, order_number, product, skus, …).
# Leave ORDER_WEBHOOK_URL unset to disable entirely.
ORDER_WEBHOOK_URL=https://workflow-rho-one.vercel.app/api/webhook/orders
ORDER_WEBHOOK_SECRET=wh_live_cXQpLMCDnEikj47kp1UX0nvEOnvPyypq

# Lead webhook — inbound API secret for POST /api/webhook/leads
# External systems send this in the x-webhook-secret header to create leads.
# Generate: openssl rand -hex 32
# Leave unset to disable the endpoint entirely.
LEAD_WEBHOOK_SECRET=

# Stripe — public card Checkout on /q/[token] (accountant confirms on /payments)
# Test keys: dashboard.stripe.com → Developers → API keys (Test mode ON)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# Local webhooks: stripe listen --forward-to localhost:3000/api/payments/stripe/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...   # from CLI output locally; Dashboard signing secret in production

